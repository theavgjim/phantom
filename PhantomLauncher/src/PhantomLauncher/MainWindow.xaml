<Window x:Class="PhantomLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PhantomLauncher.Views"
        Title="{Binding Title}" Width="1040" Height="660" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        WindowStyle="None" ResizeMode="CanResize" Icon="Assets/PhantomClient.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <v:PageToVisibility x:Key="PageVis" />
        <v:PageToChecked x:Key="PageChecked" />
        <v:CompatToBrush x:Key="CompatBrush" />
        <v:LogLevelToBrush x:Key="LevelBrush" />
        <v:BoolToBrush x:Key="StatusBrush" True="{StaticResource Good}" False="{StaticResource Dim}" />
    </Window.Resources>

    <Border BorderBrush="{StaticResource Outline}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title bar -->
            <Border Grid.ColumnSpan="2" Background="{StaticResource Bg}" BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,1">
                <DockPanel Margin="14,0,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Chrome}" Content="&#x2014;" Click="Minimize_Click" ToolTip="Minimize" />
                        <Button Style="{StaticResource Chrome}" Content="&#x25A1;" Click="Maximize_Click" ToolTip="Maximize" />
                        <Button Style="{StaticResource Chrome}" Content="&#x2715;" Click="Close_Click" ToolTip="Close" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="PHANTOM" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" Foreground="{StaticResource Accent}" />
                        <TextBlock Text="CLIENT" FontWeight="SemiBold" FontSize="14" Margin="5,0,0,0" />
                        <TextBlock Text="{Binding ClientVersion, StringFormat=v{0}}" Style="{StaticResource DimText}" Margin="10,1,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Navigation -->
            <Border Grid.Row="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource Outline}" BorderThickness="0,0,1,0" Padding="14,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Background="{StaticResource Raised}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" FontSize="12" />
                                <Button Content="Download" Margin="0,6,0,0" Style="{StaticResource Primary}" Padding="8,4"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="{Binding UpdatePageUrl}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" FontSize="11"
                                   Text="Combat and movement modules run only in singleplayer or your own LAN world." />
                    </StackPanel>
                    <StackPanel>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Content="&#x2302;  Home"
                                     IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=Home}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Home" />
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Content="&#x2630;  Profiles"
                                     IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=Profiles}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Profiles" />
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav"
                                     IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=Console}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Console">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x276F;  Console" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="14" />
                                <Border Background="{StaticResource Bad}" CornerRadius="8" Padding="6,0" Margin="8,0,0,0"
                                        Visibility="{Binding ErrorCount, Converter={x:Static v:NonZero.Instance}}">
                                    <TextBlock Text="{Binding ErrorCount}" FontSize="11" Foreground="White" />
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Content="&#x2699;  Settings"
                                     IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=Settings}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Content="&#x24D8;  About"
                                     IsChecked="{Binding Page, Converter={StaticResource PageChecked}, ConverterParameter=About}"
                                     Command="{Binding NavigateCommand}" CommandParameter="About" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Pages -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="24,20,24,16">

                <!-- HOME -->
                <Grid Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Home}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Hero -->
                    <Border CornerRadius="12" Padding="26,22" BorderBrush="{StaticResource Outline}" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#231A3D" Offset="0" />
                                <GradientStop Color="#15151F" Offset="0.7" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ready to play" Style="{StaticResource H1}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Ellipse Width="9" Height="9" Fill="{Binding CompatState, Converter={StaticResource CompatBrush}}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CompatText}" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="460" Foreground="{StaticResource Dim}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <TextBlock Text="Profile" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox Width="200" ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile}" />
                                    <Button Content="Refresh" Margin="10,0,0,0" Command="{Binding RefreshCommand}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Style="{StaticResource Launch}" Content="{Binding LaunchLabel}" Command="{Binding LaunchCommand}" MinWidth="200" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,12,0,0"
                                           TextWrapping="Wrap" MaxWidth="240" TextAlignment="Center" />
                                <ProgressBar IsIndeterminate="True" Height="3" Margin="10,8,10,0" Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Detection cards -->
                    <UniformGrid Grid.Row="1" Columns="2" Margin="-6,10,-6,0">
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="MINECRAFT" Style="{StaticResource Caps}" />
                                <TextBlock Text="{Binding MinecraftText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding VersionsText}" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding LauncherText}" Style="{StaticResource DimText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="JAVA RUNTIME" Style="{StaticResource Caps}" />
                                <TextBlock Text="{Binding JavaText}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="{Binding JavaRuntimes.Count, StringFormat={}{0} runtime(s) detected - choose one in Settings}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="MINECRAFT PROCESS" Style="{StaticResource Caps}" />
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding GameRunning, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProcessText}" Margin="8,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="PHANTOM CLIENT" Style="{StaticResource Caps}" />
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding ClientConnected, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ClientText}" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="320" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0" Text="Press Right Shift in game to open the ClickGUI" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>

                <!-- PROFILES -->
                <DockPanel Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Profiles}">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Profiles" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="Choose which configuration the client loads on the next launch. Profiles can also be managed in game (ClickGUI > Profiles)." />
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Import..." Command="{Binding ImportProfileCommand}" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="Open folder" Command="{Binding OpenFolderCommand}" CommandParameter="config" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="Duplicate selected" Command="{Binding DuplicateProfileCommand}" Margin="8,0,0,0" Style="{StaticResource Primary}" />
                            <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="New profile name" />
                        </DockPanel>
                        <TextBlock Text="{Binding ProfileMessage}" Foreground="{StaticResource Accent}" Margin="0,0,0,8" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding ProfileRows}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Use" Style="{StaticResource Primary}" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.SetActiveProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Name}" />
                                            <Button Content="Export" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.ExportProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Name}" />
                                            <Button Content="Delete" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Name}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <Border Background="#3A2A66" CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="next launch" FontSize="11" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource DimText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- CONSOLE -->
                <DockPanel Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Console}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ComboBox Width="170" ItemsSource="{Binding ConsoleFilters}" SelectedItem="{Binding ConsoleFilter}" />
                            <Button Content="Copy" Margin="8,0,0,0" Command="{Binding CopyConsoleCommand}" />
                            <Button Content="Clear" Margin="8,0,0,0" Command="{Binding ClearConsoleCommand}" />
                            <Button Content="Logs folder" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" CommandParameter="logs" />
                            <Button Content="Crash reports" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" CommandParameter="crash" />
                        </StackPanel>
                        <TextBlock Text="Console" Style="{StaticResource H1}" />
                    </DockPanel>
                    <Border Background="#0A0A0F" CornerRadius="10" BorderBrush="{StaticResource Outline}" BorderThickness="1" Padding="10">
                        <ListBox x:Name="ConsoleList" ItemsSource="{Binding ConsoleView}" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap"
                                               Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>

                <!-- SETTINGS -->
                <ScrollViewer Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Settings}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,14" />

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="GAME" Style="{StaticResource Caps}" />
                                <TextBlock Text="Minecraft directory" Margin="0,0,0,4" />
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Command="{Binding BrowseMinecraftDirCommand}" />
                                    <TextBox Text="{Binding MinecraftDirectory, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                                <TextBlock Text="Phantom instance directory (separate mods, saves and config)" Margin="0,0,0,4" />
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" CommandParameter="instance" />
                                    <TextBox Text="{Binding InstanceDirectory, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                                <TextBlock Text="Minecraft Launcher (leave empty to auto-detect)" Margin="0,0,0,4" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Command="{Binding BrowseLauncherCommand}" />
                                    <TextBox Text="{Binding LauncherPath, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="JAVA" Style="{StaticResource Caps}" />
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Command="{Binding BrowseJavaCommand}" />
                                    <ComboBox ItemsSource="{Binding JavaRuntimes}" SelectedItem="{Binding SelectedJava}" DisplayMemberPath="Display" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="Leave unselected to use the Minecraft Launcher's bundled Java 21 (recommended)." />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryText}" Width="60" TextAlignment="Right" />
                                    <TextBlock Text="Memory" Width="90" />
                                    <Slider Minimum="2048" Maximum="{Binding MaxMemoryMb}" Value="{Binding MemoryMb}" TickFrequency="512" IsSnapToTickEnabled="True" />
                                </DockPanel>
                                <TextBlock Text="Extra JVM arguments" Margin="0,12,0,4" />
                                <TextBox Text="{Binding ExtraJvmArgs, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="LAUNCHER" Style="{StaticResource Caps}" />
                                <CheckBox Content="Close Phantom Client after launching the game" IsChecked="{Binding CloseOnLaunch}" Margin="0,0,0,10" />
                                <CheckBox Content="Check for updates on startup" IsChecked="{Binding CheckUpdates}" Margin="0,0,0,10" />
                                <TextBlock Text="Release feed (GitHub releases API URL)" Margin="0,0,0,4" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Check now" Margin="8,0,0,0" Command="{Binding CheckUpdatesCommand}" />
                                    <TextBox Text="{Binding UpdateUrl, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Open launcher logs" Command="{Binding OpenFolderCommand}" CommandParameter="logs" />
                                    <Button Content="Reset settings" Margin="8,0,0,0" Command="{Binding ResetSettingsCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ABOUT -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=About}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Image Source="Assets/logo.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Phantom Client" Style="{StaticResource H1}" />
                            <TextBlock Text="{Binding ClientVersion, StringFormat=Version {0} - MIT License}" Style="{StaticResource DimText}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="VERSION COMPATIBILITY" Style="{StaticResource Caps}" />
                            <ItemsControl ItemsSource="{Binding Compat.Supported}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2">
                                            <Run Text="Minecraft" /> <Run Text="{Binding Minecraft, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="  -  Fabric Loader" Foreground="{StaticResource Dim}" /> <Run Text="{Binding FabricLoader, Mode=OneWay}" />
                                            <Run Text="  -  Java" Foreground="{StaticResource Dim}" /> <Run Text="{Binding Java, Mode=OneWay}" />
                                            <Run Text="  -  " Foreground="{StaticResource Dim}" /> <Run Text="{Binding Status, Mode=OneWay}" Foreground="{StaticResource Good}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource DimText}" LineHeight="20">
                            Phantom Client is a Fabric mod plus this launcher. It installs into a separate game folder and adds a
                            "Phantom Client" profile to the official Minecraft Launcher, which handles your Microsoft sign-in.
                            Combat training and movement testing modules only run in singleplayer or a LAN world you host.
                            Minecraft is a trademark of Mojang Studios; this project is not affiliated with Mojang or Microsoft.
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Bg}" BorderBrush="{StaticResource Outline}" BorderThickness="0,1,0,0">
                <DockPanel Margin="14,0">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource DimText}" VerticalAlignment="Center" FontSize="11"
                               Text="{Binding SelectedProfile, StringFormat=Profile: {0}}" />
                    <TextBlock Style="{StaticResource DimText}" VerticalAlignment="Center" FontSize="11" Text="{Binding Status}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
